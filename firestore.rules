rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsClass(classId) {
      return signedIn() && get(/databases/$(database)/documents/classrooms/$(classId)).data.teacherId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;

      match /joinRequests/{classId} {
        allow read, create, update: if signedIn() && request.auth.uid == userId;
        allow delete: if signedIn() && (request.auth.uid == userId || resource.data.teacherId == request.auth.uid);
      }

      match /memberships/{classId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      }
    }

    match /classrooms/{classId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.teacherId == request.auth.uid;

      match /requests/{studentId} {
        allow read: if signedIn() && (request.auth.uid == studentId || ownsClass(classId));
        allow create: if signedIn()
          && request.auth.uid == studentId
          && request.resource.data.studentId == request.auth.uid
          && request.resource.data.teacherId == get(/databases/$(database)/documents/classrooms/$(classId)).data.teacherId;
        allow delete: if signedIn() && (request.auth.uid == studentId || ownsClass(classId));
      }

      match /members/{studentId} {
        allow read: if signedIn() && (request.auth.uid == studentId || ownsClass(classId));
        allow create, update, delete: if ownsClass(classId);
      }

      match /exercises/{exerciseId} {
        allow read: if signedIn();
        allow write: if ownsClass(classId);
      }
    }
  }
}
